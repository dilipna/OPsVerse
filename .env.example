# Copy to .env and adjust. Never commit .env.
RYPE_ENVIRONMENT=dev

# Postgres
RYPE_DATABASE_URL=postgresql+asyncpg://rype:rype@localhost:5432/rype

# Redis
RYPE_REDIS_URL=redis://localhost:6379/0

# Qdrant
RYPE_QDRANT_URL=http://localhost:6333

# MinIO (S3-compatible object storage)
RYPE_MINIO_ENDPOINT=http://localhost:9000
RYPE_MINIO_ACCESS_KEY=rype
RYPE_MINIO_SECRET_KEY=rype-secret
RYPE_MINIO_BUCKET_RAW=rype-raw

# LLM providers (free tiers) — filled in from Phase 3 onward
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Observability (Phase 8): set the host to enable Langfuse tracing. Empty =
# tracing off (NullTracer). The compose `full` profile serves Langfuse on
# :3002 and bootstraps these exact keys.
# RYPE_LANGFUSE_HOST=http://localhost:3002
# RYPE_LANGFUSE_PUBLIC_KEY=pk-lf-rype-public
# RYPE_LANGFUSE_SECRET_KEY=sk-lf-rype-secret

# LLM gateway (Phase 6): daily USD kill-switch; 0 disables it.
# RYPE_GATEWAY_DAILY_BUDGET_USD=1.0

# Optional second injection layer at ingest (docs/reports/security-classifier-v1.md).
# Leave the model empty to keep it off. The key is read from the environment only.
RYPE_INJECTION_LLM_MODEL=
RYPE_INJECTION_LLM_FAIL_CLOSED=true
OPENROUTER_API_KEY=
